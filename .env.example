NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
BRAND_NAME=Impulsa
BRAND_LOGO=/icon.svg
BRAND_COLOR=#4145b7
# Local: PostgreSQL embarcado PGlite persistido em .data/postgres. Produção: PostgreSQL 16+.
DATABASE_URL=
PGLITE_DATA_DIR=.data/postgres
BETTER_AUTH_SECRET=
# Supabase Auth envia confirmação e recuperação usando o SMTP do painel.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SMTP direto é usado para convites e outros avisos do Impulsa.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Mercado Pago Assinaturas em sandbox. Use credenciais e usuários exclusivos de teste.
MERCADO_PAGO_TEST_TOKEN=
MERCADO_PAGO_TEST_SELLER_ID=
MERCADO_PAGO_TEST_PAYER_EMAIL=
MERCADO_PAGO_WEBHOOK_SECRET=
ESSENCIAL_MEMBERS=1
COMPLETO_MEMBERS=10
AI_API_KEY=
AI_MODEL=
LEGAL_ENTITY=
LEGAL_CNPJ=
LEGAL_ADDRESS=
PRIVACY_EMAIL=
CONTACT_EMAIL=
TRIAL_DAYS=7
ESSENCIAL_CENTS=4900
COMPLETO_CENTS=9900
RETENTION_DAYS=365
ESSENCIAL_RECORDS=500
COMPLETO_RECORDS=10000
# A camada de IA está preparada para um adaptador, mas não conectada a um provedor.
AI_MONTHLY_BUDGET_MICROCENTS=100000000
AI_REQUEST_RESERVE_MICROCENTS=1000000
# Obrigatório em produção; desligar só no desenvolvimento inicial.
ENFORCE_ADMIN_MFA=false

FILE_QUOTA_BYTES=52428800
# Configure somente os endereços/CIDRs dos proxies efetivamente confiáveis. Vazio = nenhum.
TRUSTED_PROXIES=

# Busca licenciada, opcional. Sem chave, somente links de pesquisa e cadastros manuais.
BRAVE_SEARCH_API_KEY=
# true SOMENTE se o contrato/plano contratado autorizar armazenar resultados.
BRAVE_STORAGE_RIGHTS=false
SEARCH_CACHE_SECONDS=300
SEARCH_COMPANY_HOURLY_LIMIT=30

# Opcional: seletor DKIM fornecido pelo seu serviço de e-mail, usado apenas pelo diagnóstico.
DKIM_SELECTOR=


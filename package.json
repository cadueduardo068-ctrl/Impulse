{
  "name": "impulsa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/migrate.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "format": "prettier --write src server shared tests scripts *.ts *.json *.js *.html public/*.js public/*.html public/*.webmanifest docs/*.md README.md",
    "test:worker": "node --experimental-strip-types --test tests/worker-auth-http.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.18",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@electric-sql/pglite": "0.5.15",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lucide-react": "1.70.0",
    "multer": "2.5.0",
    "nodemailer": "10.4.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}

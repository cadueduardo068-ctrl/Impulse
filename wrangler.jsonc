{
  "name": "impulse",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-11",
  "keep_vars": true,
  "vars": {
    "IMPULSA_API_ORIGIN": "https://impulse-u756.onrender.com",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
}
